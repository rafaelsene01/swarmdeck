on", "label": "Decision: Kanban as a second Tauri window", "file_type": "rationale", "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches original observed behavior and solves the real two-monitor case; same process shares AppState and events for free."}, {"id": "specs_features_task_kanban_design_delta_sync_decision", "label": "Decision: event-delta sync, no polling", "file_type": "rationale", "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polling wastes resources and cannot deliver the perceived <1s update; the event carries the affected task so the board never reloads everything."}, {"id": "specs_features_task_kanban_design_normalized_map_decision", "label": "Decision: normalized Map state, columns derived", "file_type": "rationale", "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A card changes column by mutating one field, avoiding moving between arrays and duplicate risk under concurrent transitions."}, {"id": "specs_features_task_kanban_design_no_drag_drop_decision", "label": "Decision: no drag-and-drop between columns in v1", "file_type": "rationale", "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not observed in the reference product and conflicts with the state machine: dragging to Completed would skip the mandatory testing phase."}, {"id": "specs_features_task_kanban_design_per_column_scroll_decision", "label": "Decision: independent per-column scroll", "file_type": "rationale", "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A board with one full column and others empty becomes unusable if the whole container scrolls together."}], "edges": [{"source": "specs_features_task_kanban_design_kanbanwindow", "target": "specs_features_task_kanban_design_kanbanboard", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_kanbanboard", "target": "specs_features_task_kanban_design_column", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_column", "target": "specs_features_task_kanban_design_taskcard", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_kanbanboard", "target": "specs_features_task_kanban_design_taskservice", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_taskcard", "target": "specs_features_task_kanban_design_sendtoterminal", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_taskchangedevent", "target": "specs_features_task_kanban_design_kanbanboard", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specs/features/task-kanban/design.md", "source_location": null, "weight": 1.0}, {"source": "specs_features_task_kanban_design_second_w